VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Keep empty when the web host proxies /api. Otherwise use the API HTTPS origin, without /api/v1.
VITE_API_URL=
# Firebase browser configuration is public. Never place a service account here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Public DSN only; never put a Sentry auth token in VITE configuration.
VITE_SENTRY_DSN=
VITE_RELEASE=
