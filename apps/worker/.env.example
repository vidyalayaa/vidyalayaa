NODE_ENV=development
WORKER_DATABASE_URL=postgresql://vidyalayaa_worker:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
TOKEN_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
DB_SSL=true
DB_POOL_SIZE=5
# DB_CA_CERT=YOUR_DATABASE_CA_PEM_WITH_ESCAPED_NEWLINES
# Optional fixed UUID for a particular worker instance. Otherwise generated at startup.
# WORKER_INSTANCE_ID=YOUR_INSTANCE_UUID
# Optional name shown in Platform Health. Set a different name for each deployment.
WORKER_NAME=Local worker
PUBLIC_WEB_URL=http://localhost:5173
# Provider credentials remain server-only. Disabled/unconfigured providers retry and are visible in health.
# FIREBASE_SERVICE_ACCOUNT_BASE64=YOUR_BASE64_SERVICE_ACCOUNT_JSON
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# EMAIL_FROM=Vidyalayaa <updates@YOUR_VERIFIED_DOMAIN>
# SMS_ADAPTER_URL=https://YOUR_ADAPTER_ENDPOINT
# SMS_ADAPTER_TOKEN=YOUR_ADAPTER_SECRET
# SMS_TEMPLATE_ID=YOUR_REGISTERED_TEMPLATE
NOTIFICATION_STALE_HOURS=24
NOTIFICATION_DAILY_CAP=8
PUSH_RATE_PER_SECOND=100
PUSH_BURST=100
EMAIL_RATE_PER_SECOND=10
EMAIL_BURST=10
SMS_RATE_PER_SECOND=10
SMS_BURST=10

SENTRY_DSN=
