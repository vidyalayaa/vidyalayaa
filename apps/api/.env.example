NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vidyalayaa_api:YOUR_PASSWORD@YOUR_HOST:5432/postgres
DEVICE_DATABASE_URL=postgresql://vidyalayaa_device:YOUR_PASSWORD@YOUR_HOST:5432/postgres
PLATFORM_DATABASE_URL=postgresql://vidyalayaa_platform:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Generate 32 random bytes encoded as 64 hexadecimal characters. Use the same key in the worker.
TOKEN_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
DB_SSL=true
# Optional: set to false to accept self-signed or cloud provider CA certificates (default is false when DB_CA_CERT is not provided)
# DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=10
TRUST_PROXY_HOPS=0
# DB_CA_CERT=YOUR_DATABASE_CA_PEM_WITH_ESCAPED_NEWLINES
# Billing is manual; the billing webhook remains disabled.

# Optional server-only error monitoring; events are scrubbed of request/user data.
SENTRY_DSN=

# Approved RSA-3072 public key only; never put a private signing key on the API.
# Approved RSA-3072 PUBLIC key only, with literal \n separators. Never configure a private signing key here.
FIRMWARE_RELEASE_PUBLIC_KEY=
