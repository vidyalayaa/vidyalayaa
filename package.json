{
  "name": "vidyalayaa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "auth:emails": "node scripts/auth-emails.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "dev": "concurrently -n web,api,worker \"npm run dev -w @vidyalayaa/web\" \"npm run dev -w @vidyalayaa/api\" \"npm run dev -w @vidyalayaa/worker\"",
    "build": "npm run build -w @vidyalayaa/contracts && npm run build -w @vidyalayaa/api && npm run build -w @vidyalayaa/worker && npm run build -w @vidyalayaa/web",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/migrate.ts --verify",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "contracts": "tsx scripts/openapi.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "guide:pdf": "python scripts/build-guide.py",
    "predev": "npm run build -w @vidyalayaa/contracts",
    "pretest": "npm run build -w @vidyalayaa/contracts",
    "precontracts": "npm run build -w @vidyalayaa/contracts",
    "lint": "node scripts/lint.mjs",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:restore-test": "tsx scripts/backup.ts restore-test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "fflate": "0.8.3",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
