# Migration-only owner connection. Never use this identity in API/worker services.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:YOUR_PASSWORD@YOUR_HOST:5432/postgres
DB_SSL=true
# Certificate and hostname verification are always enabled. Do not disable them.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CA\n-----END CERTIFICATE-----
ALLOW_DEVELOPMENT_SEED=false
